# Copy this file to .env: cp .env.example .env

# Database Configuration (Docker services)
DATABASE_URL=postgresql://scout_user:scout_password@postgres:5432/multimodal_scout

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Configuration (any OpenAI-compatible API; defaults target Ollama on the host)
# Containers reach the host through host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=gemma3:4b
LLM_EMBEDDING_MODEL=bge-m3
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_CONCURRENCY=2

# Search thresholds (cosine similarity, specific to the embedding model; these suit bge-m3)
# RESEARCH_THRESHOLD=0.52
# INDUSTRY_THRESHOLD=0.52

# Owner of bookmarks and custom topics
# LOCAL_USER_EMAIL=local@localhost

# Browser origins allowed to call the API
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seconds between pipeline runs
# PIPELINE_INTERVAL_SECONDS=1800
