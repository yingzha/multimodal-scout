# Multimodal Scout Scraper Cron Jobs
# 
# Hacker News scraper - runs every hour at minute 0
0 * * * * cd /app && python src/backend/run_hacker_news_scraper.py >> /var/log/cron.log 2>&1
#
# Hugging Face scraper - runs every 2 hours at minute 0
0 */2 * * * cd /app && python src/backend/run_huggingface_scraper.py >> /var/log/cron.log 2>&1
#
# Empty line at end (required for cron)