# Multimodal Scout Pipeline Cron Job (Local Development)
# Set environment variables for cron jobs
PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
# 
# Full content processing pipeline - runs every 30 minutes
# Uses run_pipeline.py for direct execution in local Docker environment
*/30 * * * * cd /app && echo "$(date): Starting pipeline cron job" >> /var/log/cron.log && /app/cron_env.sh /root/.local/bin/uv run python -m src.backend.run_pipeline >> /var/log/cron.log 2>&1 && echo "$(date): Pipeline cron job completed" >> /var/log/cron.log
#
# Empty line at end (required for cron)