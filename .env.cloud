# Cloud Deployment Environment Configuration
ENVIRONMENT=cloud

# Database Configuration - Will be set dynamically in deployment script
# DATABASE_URL=postgresql://scout_user:password@DB_HOST_IP:5432/multimodal_scout?sslmode=require

# Frontend Configuration - Will be set dynamically in deployment script  
# NEXT_PUBLIC_API_URL=https://backend-service-url

# Google API Configuration (required for AI features)
GOOGLE_API_KEY=your_google_api_key_here

# Production Settings
NODE_ENV=production
